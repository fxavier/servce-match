# BFF — guarda os tokens OIDC em memória do servidor (ADR-0002). O browser
# nunca vê access_token/refresh_token; só recebe um cookie de sessão opaco.
# NUNCA comitar o .env real — só este .env.example.

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Origem pública da SPA (para onde se redireciona após login/logout).
APP_ORIGIN=http://localhost:5173
# Origem pública deste BFF (usada para construir o redirect_uri do callback OIDC).
BFF_ORIGIN=http://localhost:4000
# Origem do backend (Resource Server) para onde o BFF reencaminha /api/*.
BACKEND_ORIGIN=http://localhost:8080

# --- Keycloak / OIDC (ADR-0002, ADR-0012) ---
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/servimatch
KEYCLOAK_CLIENT_ID=servimatch-bff
# Cliente confidencial — segredo só existe no BFF, nunca no bundle da SPA.
# Autentica tanto o Direct Access Grant (login) como o service account
# (registo, Admin REST API) — ver infra/README.md para a justificação de um
# único client em vez de dois.
KEYCLOAK_CLIENT_SECRET=change-me
# Base da Admin REST API usada em POST /auth/register (ADR-0012 D2). Por
# omissão derivada de KEYCLOAK_ISSUER_URI (troca /realms/{realm} por
# /admin/realms/{realm}) — só definir explicitamente se viver noutro
# host/porta.
# KEYCLOAK_ADMIN_API_BASE_URL=http://localhost:8081/admin/realms/servimatch

# --- Cookies de sessão/CSRF ---
# Segredo para assinar o cookie transitório de PKCE/state durante o login.
# Gera um valor aleatório com: openssl rand -base64 32
COOKIE_SIGNING_SECRET=change-me-to-a-long-random-value
# Em produção (HTTPS) mantém "true". Em localhost sobre http pode ter de ser
# "false" consoante o browser (Safari não trata localhost como contexto seguro).
COOKIE_SECURE=false

# --- Proxy reverso / rate limiting (ADR-0012 D7) ---
# Número explícito de saltos de proxy reverso a confiar para efeitos de
# X-Forwarded-For. NUNCA usar "true" (equivalente a confiar em qualquer
# origem) — torna o rate limiting de /auth/login e /auth/register
# contornável com um cabeçalho forjado. 0 = ignora XFF, usa sempre o IP do
# socket TCP (correto para correr sem proxy à frente, ex.: dev local). Em
# produção atrás de exatamente um proxy (nginx/ALB/etc.), usar 1.
TRUST_PROXY_HOPS=0

# Rate limiting de /auth/login e /auth/register: por IP real e por email,
# antes de contactar o Keycloak — é a mitigação real, porque com Direct
# Access Grant o Keycloak só vê o IP do BFF (ADR-0012 D7).
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_PER_IP=20
AUTH_RATE_LIMIT_MAX_PER_EMAIL=5

# --- Normalização de tempo de resposta do login (ADR-0012 D7.4) ---
# Prazo fixo (ms) para POST /auth/login, acima do p99 do caminho lento
# (password errada — paga a derivação de hash do Keycloak). Ajustar com base
# em medição real do ambiente; um piso mais baixo do que o p99 real do
# caminho lento é ele próprio um oráculo.
LOGIN_TIMING_FLOOR_MS=400
# Se o trabalho ultrapassar o piso, arredonda para cima até ao próximo
# múltiplo disto — nunca devolve o tempo exato que o Keycloak demorou.
LOGIN_TIMING_QUANTUM_MS=100
# Válvula de escape: acima disto responde-se sem esperar mais (e regista-se
# telemetria) — uma degradação do IdP não pode segurar pedidos para sempre.
LOGIN_TIMING_MAX_DELAY_MS=3000

# --- Ciclo de vida da sessão ---
# TTL absoluto (segundos), fixado na criação, imune a renovação por refresh
# token. 12h por omissão.
SESSION_ABSOLUTE_TTL_SECONDS=43200
# Intervalo (segundos) do varrimento periódico de sessões expiradas.
SESSION_SWEEP_INTERVAL_SECONDS=300

# --- Fluxo de regresso Authorization Code + PKCE (ADR-0012 D1/D10) ---
# GET /auth/login e GET /auth/callback deixaram de ser o caminho de
# utilizador (ADR-0012) — registo e login passam a ser POST /auth/register e
# POST /auth/login, formulários próprios da SPA. Este fluxo antigo fica no
# código como caminho de regresso, desligado por omissão. Só ligável por esta
# variável de ambiente no arranque do processo — nunca por cabeçalho nem
# parâmetro de pedido.
LEGACY_OIDC_FLOW_ENABLED=false
