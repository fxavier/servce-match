# Nenhum segredo aqui — apenas configuração pública de build (CLAUDE.md §5).
#
# true  -> usa a camada de mocks (services/mock, MSW): arranca sem qualquer
#          serviço externo, dados portugueses credíveis, latência artificial.
# false -> usa o cliente HTTP real (openapi-fetch) contra o BFF em VITE_API_BASE.
VITE_USE_MOCKS=true

# Caminho base para o domínio (sempre através do BFF, nunca diretamente para
# o backend nem para o Keycloak — ADR-0002). Em dev, o Vite faz proxy deste
# caminho e de /auth para o BFF (ver vite.config.ts).
VITE_API_BASE=/api

# Só precisas de definir isto se o BFF não estiver em localhost:4000.
VITE_BFF_ORIGIN=http://localhost:4000
