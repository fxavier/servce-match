# Nenhum segredo aqui — apenas configuração pública de build (CLAUDE.md §5).

# Caminho base para o domínio (sempre através do BFF, nunca diretamente para
# o backend nem para o Keycloak — ADR-0002/ADR-0012). Em dev, o Vite faz
# proxy deste caminho e de /auth para o BFF (ver vite.config.ts).
VITE_API_BASE=/api

# Só precisas de definir isto se o BFF não estiver em localhost:4000.
VITE_BFF_ORIGIN=http://localhost:4000
