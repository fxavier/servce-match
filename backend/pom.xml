<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    ServiMatch backend — Spring Boot + Spring Modulith modular monolith.

    Baseline fechada pelo ADR-0003 (docs/adr/0003-versao-stack-backend.md):
    Java 21 LTS + Spring Boot 3.5.x + Spring Modulith 1.4.x. Não alterar sem
    um ADR substituto.

    Ownership: este ficheiro é propriedade exclusiva do agente
    `backend-platform` (CLAUDE.md, secção 3). Outros agentes pedem
    dependências novas em vez de as adicionarem diretamente.
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>pt.servimatch</groupId>
  <artifactId>servimatch-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>ServiMatch Backend</name>
  <description>
    Marketplace B2C de serviços locais — modular monolith (Spring Modulith)
    sobre Spring Boot 3.5.x / Java 21. Ver docs/ARQUITETURA.md e docs/adr/.
  </description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>

    <!-- ADR-0003: baseline fechada. Spring Modulith 1.4.x alinhado com Boot 3.5.x. -->
    <spring-modulith.version>1.4.12</spring-modulith.version>

    <!-- Bucket4j (rate limiting, ADR-0006). Artefactos "_jdk17" são a linha
         ativamente publicada, compatível com Java 17+ (usamos Java 21). -->
    <bucket4j.version>8.19.0</bucket4j.version>

    <!-- AWS SDK v2 (client S3, ARQUITETURA §14: "Object store: Amazon S3 /
         Cloudflare R2 (produção), MinIO (desenvolvimento) — API compatível
         com S3"). Usado só por modules/uploads para emitir URLs
         pré-assinados e ler magic bytes na confirmação; nenhum outro módulo
         deve depender diretamente do SDK — passa pela API pública do
         módulo. -->
    <aws-sdk.version>2.31.45</aws-sdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>

    <!-- ==================== Web / API ==================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ==================== Segurança — OAuth2 Resource Server (ADR-0002/0009) ==================== -->
    <!-- Apenas validação de JWT contra o JWKS do Keycloak. Sem emissão de
         tokens, sem hashing de passwords: isso é do Keycloak. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- ==================== Spring Modulith (ADR-0001) ==================== -->
    <!-- Registo de fronteiras + Event Publication Registry (entrega
         at-least-once, tabela de publicações e reentrega). Backend JDBC
         (não JPA): o registo de eventos é infraestrutura transversal e não
         deve obrigar a stack ORM que os módulos de domínio ainda vão
         escolher. -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-jdbc</artifactId>
    </dependency>
    <!-- Observabilidade das fronteiras/eventos de módulo (Micrometer/OTel). -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-observability</artifactId>
    </dependency>

    <!-- ==================== Base de dados / migrações ==================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Escopo `compile` (não `runtime`): pt.servimatch.platform.error.ExceptionLogSupport
         lê org.postgresql.util.PSQLException/ServerErrorMessage em tempo de
         compilação para extrair só campos de schema (SQLState, nome da
         constraint/tabela) ao registar uma DataIntegrityViolationException —
         nunca a mensagem/Detail, que o driver embute com a linha rejeitada.
         Módulos de domínio continuam a não dever importar org.postgresql.*
         diretamente (usar Spring Data/JdbcTemplate); isto só alarga o que é
         *possível* compilar, não o que é aprovado em revisão. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ==================== Redis (ADR-0006, condicional multi-instância) ==================== -->
    <!-- Sempre no classpath; só ativado por configuração
         (servimatch.rate-limit.backend=redis / perfil multi-instância).
         Single-instance usa buckets em memória — ver
         pt.servimatch.platform.ratelimit. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- ==================== Rate limiting (Bucket4j) ==================== -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j_jdk17-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j_jdk17-lettuce</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>

    <!-- Cache local (idempotência em memória em single-instância; ADR-0006). -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!-- ==================== Object storage (modules/uploads) ==================== -->
    <!-- URLs pré-assinados (S3Presigner) e leitura de magic bytes na
         confirmação. API compatível S3 — MinIO em desenvolvimento
         (infra/docker-compose.yml), S3/R2 em produção. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <!-- Só usamos o cliente síncrono (apache-client, abaixo); o cliente
           Netty transitivo não é necessário e traz uma versão de
           io.netty:netty-codec-http* não presente no cache offline. -->
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>apache-client</artifactId>
    </dependency>

    <!-- ==================== Observabilidade ==================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>

    <!-- ==================== Testes ==================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers (ADR-0003 stack, CLAUDE.md §5): testes de integração
         dos módulos de domínio contra um Postgres/PostGIS real, em vez de um
         banco embutido que não replica o comportamento de produção.
         Versões geridas pela BOM importada por spring-boot-starter-parent —
         não fixar aqui. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!--
        ADR-0013 D3, camada 1 (a barreira mecânica principal, não a de
        conveniência): exclui `db/seed/**` — dados de demonstração dev-only
        (ADR-0013) — do artefacto de produção. Um ficheiro que não existe no
        JAR não corre, por muito que `SPRING_FLYWAY_LOCATIONS` ou um perfil
        errado o peçam (essa é a camada 3,
        pt.servimatch.platform.seed.SeedLocationsGuard).

        Configurado no maven-jar-plugin (não em <resources> do <build>):
        excluir por <resources> tiraria `db/seed` também de
        `target/classes`, e é aí que `mvn spring-boot:run`/o arranque a
        partir do IDE com o perfil `local` vai buscar os ficheiros — partia
        exatamente o caso de uso que este seed serve. O
        `spring-boot-maven-plugin` (goal `repackage`, acima) reembrulha o
        JAR fino produzido por este plugin para o executável final; o que
        aqui se exclui não reaparece no repackage — verificável com
        `unzip -l target/servimatch-backend-*.jar | grep db/seed` (deve
        devolver vazio).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>db/seed/**</exclude>
          </excludes>
        </configuration>
      </plugin>
      <!--
        Convenção de nomenclatura de testes deste projeto: TUDO é *Test.java
        (Surefire, fase "test"), incluindo testes de integração pesados com
        Testcontainers (ex. PaymentsApiIntegrationTest,
        TestcontainersPostgisMigrationTest) — não há uma fase "integration
        separada de "unit" neste build. Um agente já escreveu um *IT.java à
        espera da convenção Maven Failsafe padrão, viu-o passar com
        `-Dtest=`, e só descobriu em `mvn verify` completo que nunca corria
        (Surefire, por omissão, não apanha `*IT.java`) — ver relatório de
        entrega do agente backend-platform, onda "uploads".

        Em vez de só documentar a convenção (fácil de voltar a ignorar),
        este plugin torna-a estruturalmente impossível de contornar
        silenciosamente: qualquer `*IT.java`/`*ITCase.java`/`IT*.java`
        escrito por engano passa a correr mesmo assim, na fase
        "integration-test" deste `mvn verify` — nunca fica invisível.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <!-- Spring Boot 3.5.16 (parent) não gere a versão deste plugin
             (só o de Surefire); fixada explicitamente ao par
             plugin/provider (org.apache.maven.surefire:surefire-junit-platform)
             disponível no cache local — 3.5.4 resolve o plugin mas não o
             provider correspondente em modo offline. -->
        <version>3.5.3</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
