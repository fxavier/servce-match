        { "type": "password", "value": "DevLocal#2026", "temporary": false }
      ],
      "realmRoles": ["PROVIDER"]
    },
    {
      "id": "65d60604-b03b-4a20-8c55-f141bde0e122",
      "username": "service-account-servimatch-bff",
      "enabled": true,
      "emailVerified": false,
