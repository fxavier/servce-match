      "credentials": [
        { "type": "password", "value": "DevLocal#2026", "temporary": false }
      ],
      "realmRoles": ["PROVIDER"]
    },
    {
      "id": "35295b6c-a788-4f2b-bc22-8edc292aaf81",
      "username": "admin.test@servimatch.pt",
      "email": "admin.test@servimatch.pt",
