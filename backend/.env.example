# Variáveis de ambiente do backend ServiMatch — copiar para .env (NUNCA
# comitar o .env real) ou exportar diretamente no ambiente de execução.
# Nenhum destes valores tem um segredo real por omissão em application.yml.
#
# Em produção (SPRING_PROFILES_ACTIVE=prod, ver application-prod.yml),
# DB_PASSWORD e UPLOADS_S3_SECRET_KEY deixam de ter default: têm de estar
# definidas (mesmo que vazias, no caso de UPLOADS_S3_SECRET_KEY, para usar
# IAM) ou o arranque falha.

# --- Base de dados (PostgreSQL + PostGIS) ---
DB_URL=jdbc:postgresql://localhost:5432/servimatch
DB_USERNAME=servimatch
DB_PASSWORD=change-me

# --- Keycloak (ADR-0002/0009) — o backend só valida tokens, nunca os emite ---
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/servimatch
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/servimatch/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=servimatch-backend

# --- Redis (ADR-0006) — só usado com SPRING_PROFILES_ACTIVE=multi-instance ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Rate limiting (ADR-0006) — CIDR/IP dos proxies de confiança cujo
#     X-Forwarded-For é honrado (vazio = nunca confiar no cabeçalho) ---
RATE_LIMIT_TRUSTED_PROXIES=

# --- Uploads (modules/uploads) — object storage compatível S3; valores por
#     omissão coincidem com o MinIO local (infra/docker-compose.yml) ---
UPLOADS_S3_ENDPOINT=http://localhost:9000
UPLOADS_S3_REGION=eu-west-1
UPLOADS_S3_BUCKET=servimatch-uploads
UPLOADS_S3_ACCESS_KEY=servimatch
UPLOADS_S3_SECRET_KEY=servimatch123
UPLOADS_S3_PATH_STYLE=true

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- Servidor ---
SERVER_PORT=8080

# --- Spring ---
SPRING_PROFILES_ACTIVE=
