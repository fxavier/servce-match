# Variáveis de ambiente do backend ServiMatch — copiar para .env (NUNCA
# comitar o .env real) ou exportar diretamente no ambiente de execução.
# Nenhum destes valores tem um segredo real por omissão em application.yml.

# --- Base de dados (PostgreSQL + PostGIS) ---
DB_URL=jdbc:postgresql://localhost:5432/servimatch
DB_USERNAME=servimatch
DB_PASSWORD=change-me

# --- Keycloak (ADR-0002/0009) — o backend só valida tokens, nunca os emite ---
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/servimatch
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/servimatch/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=servimatch-backend

# --- Redis (ADR-0006) — só usado com SPRING_PROFILES_ACTIVE=multi-instance ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- Servidor ---
SERVER_PORT=8080

# --- Spring ---
SPRING_PROFILES_ACTIVE=
