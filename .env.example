# Variáveis do ambiente local do ServiMatch (infra/docker-compose.yml).
#
# Copia este ficheiro para `.env` na raiz do repositório e ajusta se
# necessário. `.env` está no .gitignore — NUNCA commitar segredos reais.
# Todos os valores abaixo são fictícios/de desenvolvimento; em staging/
# produção são injetados por variável de ambiente ou secret manager, nunca
# lidos deste ficheiro.
#
# Arrancar:
#   cp .env.example .env
#   docker compose -f infra/docker-compose.yml --env-file .env up -d
#
# Ver infra/README.md para mais detalhe (paragem, reset, token de teste).

# ---------------------------------------------------------------------------
# PostgreSQL + PostGIS (ADR-0004) — também aloja a base de dados do Keycloak
# ---------------------------------------------------------------------------
POSTGRES_USER=servimatch
POSTGRES_PASSWORD=servimatch
POSTGRES_DB=servimatch
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Keycloak (ADR-0002) — IdP único; o backend nunca gere passwords/tokens
# ---------------------------------------------------------------------------
KEYCLOAK_PORT=8081
# Admin do realm "master" (consola de administração). Só para este ambiente
# local descartável — nunca reutilizar este valor noutro ambiente.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Emitidas pelo realm importado (infra/keycloak/realm-servimatch.json);
# usadas pelo backend (Resource Server) e pelos clientes OIDC. Os nomes
# abaixo têm de corresponder exatamente aos lidos por cada consumidor —
# ver backend/.env.example para a lista completa/autoritativa do backend
# (propriedade daquele agente; não duplicada aqui).
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/servimatch
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/servimatch/protocol/openid-connect/certs
# Client "servimatch-backend" (bearer-only) — audiência que o Resource
# Server exige na claim `aud` de todo o token (ADR-0002: validação de
# iss/aud/exp). Injetada nos tokens dos restantes clients por um
# protocol mapper `oidc-audience-mapper` no client scope
# "servimatch-backend-audience", atribuído por omissão a
# servimatch-web/-bff/-mobile/-local-test.
KEYCLOAK_AUDIENCE=servimatch-backend
KEYCLOAK_REALM=servimatch
KEYCLOAK_WEB_CLIENT_ID=servimatch-web
KEYCLOAK_MOBILE_CLIENT_ID=servimatch-mobile
KEYCLOAK_BFF_CLIENT_ID=servimatch-bff
# Segredo de desenvolvimento do client confidencial do BFF — tem de
# corresponder ao "secret" definido em infra/keycloak/realm-servimatch.json
# para este realm local. Nunca é o segredo real de produção.
KEYCLOAK_BFF_CLIENT_SECRET=dev-only-bff-secret-never-reused-elsewhere

# ---------------------------------------------------------------------------
# Redis (ADR-0006) — opcional em instância única, obrigatório em
# multi-instância. Só arranca com `--profile redis` (ver infra/README.md).
# ---------------------------------------------------------------------------
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# MinIO — substituto local de S3 para uploads (§8.6/§11.2). Ficheiros
# servidos sempre por URL pré-assinado com expiração, nunca publicamente.
# ---------------------------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=servimatch
MINIO_ROOT_PASSWORD=servimatch123
MINIO_BUCKET_UPLOADS=servimatch-uploads

# ---------------------------------------------------------------------------
# Observabilidade (§16 de docs/ARQUITETURA.md). Sem coletor OTel no
# docker-compose local; o valor abaixo é o mesmo default do backend
# (application.yml) para não sobrepor um endpoint vazio quando a variável
# está definida mas sem valor.
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=servimatch-backend

# ---------------------------------------------------------------------------
# Pagamentos (ADR-0007) — nunca reais em desenvolvimento; chaves de teste
# do fornecedor. Preenchido pelo backend-payments.
# ---------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
EUPAGO_API_KEY=
